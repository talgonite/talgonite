import { Theme } from "../theme.slint";
import { NetworkState } from "../network_state.slint";

export component DisconnectOverlay inherits Rectangle {
    background: Theme.overlay-strong;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    key-scope := FocusScope {
        init => {
            key-scope.focus();
        }
        key-pressed(event) => { return accept; }
        key-released(event) => { return accept; }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 420px;
                background: Theme.surface-modal;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.border-danger;

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    Text {
                        text: "Network Disconnected";
                        font-size: Theme.font-size-xlarge;
                        font-weight: 700;
                        color: Theme.danger-foreground;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "The connection to the server was lost. Press OK to return to the login screen.";
                        font-size: Theme.font-size-medium;
                        color: Theme.foreground;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        padding-top: 6px;
                        ok-btn := Rectangle {
                            width: 120px;
                            height: 34px;
                            background: ok-touch.has-hover ? Theme.fill-danger : Theme.fill-danger-dark;
                            border-radius: Theme.radius-small;
                            border-width: 1px;
                            border-color: Theme.border-danger;
                            animate background { duration: 80ms; }

                            Text {
                                text: "OK";
                                font-size: Theme.font-size-medium;
                                font-weight: 600;
                                color: Theme.foreground-strong;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            ok-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    NetworkState.acknowledged();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
