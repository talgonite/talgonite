import { Theme } from "../../theme.slint";
import { SettingsState, KeyBinding } from "../../settings_state.slint";
import { VerticalBox, ScrollView, HorizontalBox } from "std-widgets.slint";
import { SectionHeader, KeyBindingRow } from "widgets.slint";

component BindingSection inherits VerticalBox {
    in property <string> title;
    in property <[KeyBinding]> bindings;
    spacing: Theme.spacing-xsmall;
    alignment: start;
    SectionHeader {
        title: root.title;
    }

    for b in root.bindings: KeyBindingRow {
        action-label: b.label;
        current-key: b.primary;
        current-key-2: b.secondary;
        action-id: b.id;
        is-rebinding: SettingsState.rebinding-action == b.id;
        rebinding-index: SettingsState.rebinding-index;
        start-rebind(idx) => {
            SettingsState.start-rebind(b.id, idx);
        }
        unbind-key(idx) => {
            SettingsState.unbind-key(b.id, idx);
        }
    }
}

export component ControlsTab inherits VerticalBox {
    spacing: Theme.spacing-small;
    padding: Theme.spacing-medium;
    VerticalBox {
        spacing: Theme.spacing-xsmall;
        alignment: start;
        BindingSection {
            title: "Movement";
            bindings: SettingsState.bindings-movement;
        }

        Rectangle {
            height: Theme.spacing-small;
        }

        BindingSection {
            title: "World Interaction";
            bindings: SettingsState.bindings-world;
        }

        Rectangle {
            height: Theme.spacing-small;
        }

        BindingSection {
            title: "Combat";
            bindings: SettingsState.bindings-combat;
        }

        Rectangle {
            height: Theme.spacing-small;
        }

        BindingSection {
            title: "Interface";
            bindings: SettingsState.bindings-interface;
        }

        Rectangle {
            height: Theme.spacing-small;
        }

        SectionHeader {
            title: "Hotbar Slots";
        }

        Rectangle {
            height: 34px;
            background: transparent;
            toggle-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    SettingsState.modifier-hotbar-rows-target-custom-only = !SettingsState.modifier-hotbar-rows-target-custom-only;
                    SettingsState.modifier-hotbar-rows-target-custom-only-changed(SettingsState.modifier-hotbar-rows-target-custom-only);
                }
            }

            HorizontalBox {
                spacing: 12px;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.surface-card;
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: toggle-touch.has-hover ? Theme.accent : Theme.border-muted;
                    if SettingsState.modifier-hotbar-rows-target-custom-only: Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 10px;
                        height: 10px;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }

                Text {
                    text: "Modifier rows target custom hotbars only";
                    font-size: Theme.font-size-label;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    width: 40px;
                    text: SettingsState.modifier-hotbar-rows-target-custom-only ? "On" : "Off";
                    font-size: Theme.font-size-medium;
                    color: Theme.foreground-muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        for b in SettingsState.bindings-hotbar: KeyBindingRow {
            action-label: b.label;
            current-key: b.primary;
            current-key-2: b.secondary;
            action-id: b.id;
            is-rebinding: SettingsState.rebinding-action == b.id;
            rebinding-index: SettingsState.rebinding-index;
            start-rebind(idx) => {
                SettingsState.start-rebind(b.id, idx);
            }
            unbind-key(idx) => {
                SettingsState.unbind-key(b.id, idx);
            }
        }

        Rectangle {
            height: Theme.spacing-small;
        }

        BindingSection {
            title: "Panel Switching";
            bindings: SettingsState.bindings-panels;
        }
    }
}