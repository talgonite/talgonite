import { GameState } from "../game_state.slint";
import { Theme } from "../theme.slint";

export component GroupInvitePopup inherits Rectangle {
    width: 320px;
    height: 150px;
    background: Theme.surface-invite;
    border-radius: 8px;
    border-width: 2px;
    border-color: Theme.info;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000090;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Group Invite";
            font-size: Theme.font-size-label;
            font-weight: 700;
            color: Theme.info-border;
        }

        Text {
            text: GameState.group-invite.source-name + " invites you to join their group.";
            font-size: Theme.font-size-medium;
            color: Theme.neutral-strong;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            accept-btn := Rectangle {
                width: 110px;
                height: 30px;
                background: accept-touch.has-hover ? Theme.fill-success-hover : Theme.fill-success;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.status-online.with-alpha(0.6);
                animate background { duration: 80ms; }
                Text {
                    text: "Accept";
                    font-size: Theme.font-size-medium;
                    font-weight: 600;
                    color: Theme.foreground-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                accept-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        GameState.respond-group-invite(true, GameState.group-invite.source-name);
                    }
                }
            }

            decline-btn := Rectangle {
                width: 110px;
                height: 30px;
                background: decline-touch.has-hover ? Theme.status-busy : Theme.fill-danger;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.status-busy.with-alpha(0.6);
                animate background { duration: 80ms; }
                Text {
                    text: "Decline";
                    font-size: Theme.font-size-medium;
                    font-weight: 600;
                    color: Theme.foreground-strong;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                decline-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        GameState.respond-group-invite(false, GameState.group-invite.source-name);
                    }
                }
            }
        }
    }
}
