import {
    GameState,
    SlotPanelType,
    Skill,
    Spell,
    PopupState,
} from "../game_state.slint";
import { PopupManagerState, PopupId } from "../popup_manager.slint";
import { Theme } from "../theme.slint";
import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { DragDropItem } from "drag_drop.slint";
import { Icon } from "./icon.slint";
import { BasePanel } from "./base_panel.slint";

component ActionTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    background: active ? Theme.accent-subtle : transparent;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: active ? Theme.accent-muted : transparent;
    Text {
        text: root.text;
        color: active ? Theme.accent : Theme.foreground-muted;
        font-weight: active ? 700 : 400;
        font-size: Theme.font-size-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SkillRow inherits Rectangle {
    in property <Skill> skill;
    height: 48px;
    background: Theme.surface-muted;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.border-muted;
    Rectangle {
        width: parent.width;
        height: parent.height;
        HorizontalBox {
            padding-left: Theme.spacing-small;
            padding-right: Theme.spacing-small;
            spacing: Theme.spacing-small;
            Icon {
                icon: skill.icon;
                cooldown-total: skill.cooldown.total;
                cooldown-left: skill.cooldown.time_left;
            }

            Text {
                text: skill.name;
                color: Theme.foreground;
                vertical-alignment: center;
                font-size: Theme.font-size-small;
            }
        }

        states [
            dragging when skill-drag.dragging: {
                opacity: 0.5;
            }
        ]
    }

    skill-drag := DragDropItem {
        draggable: skill.icon.width > 0;
        slot-index: skill.slot;
        panel-type: SlotPanelType.skill;
        drag-image: skill.icon;
        drag-image-offset-x: skill.icon.width / 2;
        drag-image-offset-y: skill.icon.height / 2;
        double-clicked => {
            if skill.icon.width > 0 {
                GameState.use-action(SlotPanelType.skill, skill.slot);
            }
        }
    }

    property <bool> has-tooltip: skill-drag.has-hover && skill.icon.width > 0 && !skill-drag.dragging;
    changed has-tooltip => {
        if (root.has-tooltip) {
            PopupState.show(skill.name, self.absolute-position.x, self.absolute-position.y, root.width, root.height);
        } else {
            PopupState.hide();
        }
    }
    states [
        hover when skill-drag.has-hover && skill.icon.width > 0 && !skill-drag.dragging: {
            border-color: Theme.accent-muted;
            background: Theme.surface-secondary;
        }
        drop-hover when skill-drag.has-drag: {
            border-color: Theme.accent;
        }
    ]
}

component SpellRow inherits Rectangle {
    in property <Spell> spell;
    height: 48px;
    background: Theme.surface-muted;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: spell.cast-progress > 0 ? Theme.accent : Theme.border-muted;

    // Draggable container
    Rectangle {
        width: parent.width;
        height: parent.height;
        HorizontalBox {
            padding-left: Theme.spacing-small;
            padding-right: Theme.spacing-small;
            spacing: Theme.spacing-small;
            Icon {
                icon: spell.icon;
                cast-progress: spell.cast-progress;
            }

            Text {
                text: spell.name;
                color: spell.cast-progress > 0 ? Theme.accent : Theme.foreground;
                vertical-alignment: center;
                font-size: Theme.font-size-small;
            }
        }

        states [
            dragging when spell-drag.dragging: {
                opacity: 0.5;
            }
        ]
    }

    spell-drag := DragDropItem {
        draggable: spell.icon.width > 0;
        slot-index: spell.slot;
        panel-type: SlotPanelType.spell;
        drag-image: spell.icon;
        drag-image-offset-x: spell.icon.width / 2;
        drag-image-offset-y: spell.icon.height / 2;
        double-clicked => {
            if spell.icon.width > 0 {
                GameState.use-action(SlotPanelType.spell, spell.slot);
            }
        }
    }

    property <bool> has-tooltip: spell-drag.has-hover && spell.icon.width > 0 && !spell-drag.dragging;
    changed has-tooltip => {
        if (root.has-tooltip) {
            PopupState.show(spell.name, self.absolute-position.x, self.absolute-position.y, root.width, root.height);
        } else {
            PopupState.hide();
        }
    }
    states [
        hover when spell-drag.has-hover && spell.icon.width > 0 && !spell-drag.dragging: {
            border-color: Theme.accent-muted;
            background: Theme.surface-secondary;
        }
        drop-hover when spell-drag.has-drag: {
            border-color: Theme.accent;
        }
    ]
}

export component ActionsPanel inherits BasePanel {
    in-out property <string> active-tab: "skills";
    title: "Actions";
    width: 340px;
    height: 520px;
    close => {
        PopupManagerState.close-request(PopupId.Skills);
        PopupManagerState.close-request(PopupId.Spells);
    }
    VerticalBox {
        padding: Theme.spacing-medium;
        spacing: Theme.spacing-medium;

        // Tabs
        HorizontalLayout {
            height: 32px;
            spacing: Theme.spacing-small;
            ActionTab {
                text: "Skills";
                active: root.active-tab == "skills";
                clicked => {
                    root.active-tab = "skills";
                }
            }

            ActionTab {
                text: "Spells";
                active: root.active-tab == "spells";
                clicked => {
                    root.active-tab = "spells";
                }
            }
        }

        // List container
        Rectangle {
            background: Theme.surface-muted;
            border-radius: Theme.radius-small;
            clip: true;
            ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;

                VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    alignment: start;
                    if root.active-tab == "skills": VerticalLayout {
                        spacing: 4px;
                        for skill in GameState.skills: SkillRow {
                            skill: skill;
                        }
                    }
                    if root.active-tab == "spells": VerticalLayout {
                        spacing: 4px;
                        for spell in GameState.spells: SpellRow {
                            spell: spell;
                        }
                    }
                }
            }
        }
    }
}
