// PopupLayer — renders every open popup in `open-popups` order (later = on top)
// behind one shared dim backdrop.

import { PopupManagerState, PopupId } from "../popup_manager.slint";
import { MailBoardState } from "../mail_board_state.slint";
import { Theme } from "../theme.slint";
import { LineEdit, TextEdit } from "std-widgets.slint";
import { NpcDialog } from "./menu_dialog.slint";
import { SettingsPanel } from "settings/panel.slint";
import { GameMenuPanel } from "settings/game_menu.slint";
import { InventoryPanel } from "./inventory_panel.slint";
import { ActionsPanel } from "./actions_panel.slint";
import { WorldListPanel } from "./world_list.slint";
import { GroupPanel } from "./group_panel.slint";
import { ProfilePanel } from "./profile_panel.slint";
import { WorldContextMenuOverlay } from "./world_context_menu.slint";
import { GroupInvitePopup } from "./group_invite_popup.slint";
import { MailBoardPanel, MailActionButton } from "./mail_board_panel.slint";
import { WorldMap } from "./world_map.slint";
import { ExchangePanel } from "./exchange_panel.slint";

// Renders one open popup; close handling lives inside each component.
export component PopupHost inherits Rectangle {
    in property <PopupId> id;
    in property <string> actions-tab: "skills";
    width: 100%;
    height: 100%;

    // ---- Modals ----
    if (id == PopupId.GameMenu): VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            GameMenuPanel { }
        }
    }
    if (id == PopupId.Settings): HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            preferred-width: 600px;
            SettingsPanel { }
        }
    }
    if (id == PopupId.NpcDialog): NpcDialog {
        width: 100%;
        height: 100%;
    }
    if (id == PopupId.Profile): ProfilePanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (id == PopupId.MailBoard): MailBoardPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if (id == PopupId.WorldMap): WorldMap {
        width: 100%;
        height: 100%;
    }
    if (id == PopupId.Exchange): ExchangePanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // ---- Windows ----
    if (id == PopupId.Inventory): InventoryPanel {
        x: parent.width - 420px;
        y: 60px;
    }
    if (id == PopupId.Skills || id == PopupId.Spells): ActionsPanel {
        x: parent.width - 490px;
        y: 60px;
        active-tab: actions-tab;
    }
    if (id == PopupId.WorldList): WorldListPanel {
        x: parent.width - 470px;
        y: 60px;
    }
    if (id == PopupId.Group): GroupPanel {
        x: parent.width - 350px;
        y: 60px;
    }

    // ---- Popovers ----
    if (id == PopupId.ContextMenu): WorldContextMenuOverlay {
        width: 100%;
        height: 100%;
        screen-width: parent.width;
        screen-height: parent.height;
    }

    // ---- Toasts ----
    if (id == PopupId.GroupInvite): GroupInvitePopup {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 120px;
    }
}

export component PopupLayer inherits Rectangle {
    in property <string> actions-tab: "skills";
    background: transparent;

    // Shared dim backdrop; clicking closes the topmost popup.
    if (PopupManagerState.has-modal): Rectangle {
        background: #0007;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                PopupManagerState.close-top-request();
            }
        }
    }

    for id in PopupManagerState.open-popups: PopupHost {
        id: id;
        actions-tab: root.actions-tab;
    }

    if (MailBoardState.deleting-post-id >= 0): Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000a;

        TouchArea { }

        Rectangle {
            width: 380px;
            height: 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel-background;
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.border-panel;

            VerticalLayout {
                padding: Theme.spacing-large;
                spacing: Theme.spacing-medium;
                alignment: center;

                Rectangle { }

                Text {
                    text: MailBoardState.delete-message == "" ? "Deleting post..." : MailBoardState.delete-message;
                    color: Theme.foreground;
                    font-size: Theme.font-size-medium;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if MailBoardState.delete-message == "": Text {
                    text: "Waiting for the server to confirm...";
                    color: Theme.foreground-muted;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: center;
                }

                if MailBoardState.delete-message != "": MailActionButton {
                    width: 120px;
                    label: "OK";
                    emphasis: "primary";
                    clicked => {
                        MailBoardState.delete-dismiss();
                    }
                }

                Rectangle { }
            }
        }
    }

    if (MailBoardState.compose-visible): Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000a;

        TouchArea { }

        Rectangle {
            width: 480px;
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel-background;
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.border-panel;

            VerticalLayout {
                padding: Theme.spacing-large;
                spacing: Theme.spacing-medium;

                Text {
                    text: MailBoardState.compose-title;
                    color: Theme.foreground-strong;
                    font-size: Theme.font-size-medium;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                if MailBoardState.compose-waiting: VerticalLayout {
                    spacing: Theme.spacing-small;

                    Rectangle { }

                    Text {
                        text: "Sending...";
                        color: Theme.foreground-strong;
                        font-size: Theme.font-size-medium;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Waiting for the server to confirm.";
                        color: Theme.foreground-muted;
                        font-size: Theme.font-size-small;
                        horizontal-alignment: center;
                    }

                    Rectangle { }
                }

                if MailBoardState.compose-result != "": VerticalLayout {
                    spacing: Theme.spacing-medium;

                    Rectangle { }

                    Text {
                        text: MailBoardState.compose-result;
                        color: Theme.foreground;
                        font-size: Theme.font-size-medium;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    MailActionButton {
                        width: 120px;
                        label: "OK";
                        emphasis: "primary";
                        clicked => {
                            MailBoardState.compose-cancel();
                        }
                    }

                    Rectangle { }
                }

                if !MailBoardState.compose-waiting && MailBoardState.compose-result == "": VerticalLayout {
                    spacing: Theme.spacing-medium;

                    HorizontalLayout {
                        spacing: Theme.spacing-small;

                        Text {
                            width: 48px;
                            text: MailBoardState.compose-name-label;
                            color: Theme.foreground-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> MailBoardState.compose-name;
                            enabled: MailBoardState.compose-name-editable;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-small;

                        Text {
                            width: 48px;
                            text: "Subject";
                            color: Theme.foreground-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> MailBoardState.compose-subject;
                        }
                    }

                    Text {
                        text: "Message";
                        color: Theme.foreground-muted;
                        font-size: Theme.font-size-small;
                    }

                    TextEdit {
                        text <=> MailBoardState.compose-body;
                        height: 150px;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.spacing-medium;

                        MailActionButton {
                            width: 120px;
                            label: "Send";
                            emphasis: "primary";
                            clicked => {
                                MailBoardState.compose-send();
                            }
                        }

                        MailActionButton {
                            width: 120px;
                            label: "Cancel";
                            clicked => {
                                MailBoardState.compose-cancel();
                            }
                        }
                    }
                }
            }
        }
    }
}
