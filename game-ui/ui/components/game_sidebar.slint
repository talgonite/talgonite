import { GameState } from "../game_state.slint";
import { PopupManagerState, PopupId } from "../popup_manager.slint";
import { Theme } from "../theme.slint";
import { VerticalBox } from "std-widgets.slint";

component SidebarButton inherits Rectangle {
    in property <bool> active;
    in property <image> icon;
    callback clicked();
    width: 48px;
    height: 48px;
    background: active ? Theme.accent-subtle : Theme.surface-muted;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border-muted;
    Image {
        source: icon;
        width: 28px;
        height: 28px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: active ? Theme.accent : Theme.foreground-muted;
    }

    states [
        hover when touch.has-hover: {
            background: Theme.surface-secondary;
            border-color: Theme.accent-muted;
        }
    ]
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component GameSidebar inherits Rectangle {
    width: 64px;
    height: 212px;
    Rectangle {
        width: parent.width;
        height: parent.height + 30px;
        background: @radial-gradient(circle, #00000030 0%, #00000015 40%, #00000000 100%);
    }

    VerticalBox {
        padding-top: Theme.spacing-medium;
        padding-left: Theme.spacing-small;
        padding-right: Theme.spacing-small;
        spacing: Theme.spacing-small;
        alignment: start;
        SidebarButton {
            active: PopupManagerState.inventory-open;
            icon: @image-url("../icons/backpack.svg");
            clicked => {
                if (PopupManagerState.inventory-open) {
                    PopupManagerState.close-request(PopupId.Inventory);
                } else {
                    PopupManagerState.close-request(PopupId.Skills);
                    PopupManagerState.close-request(PopupId.Spells);
                    PopupManagerState.open-request(PopupId.Inventory);
                }
            }
        }

        SidebarButton {
            active: PopupManagerState.skills-open || PopupManagerState.spells-open;
            icon: @image-url("../icons/magic.svg");
            clicked => {
                if (PopupManagerState.skills-open || PopupManagerState.spells-open) {
                    PopupManagerState.close-request(PopupId.Skills);
                    PopupManagerState.close-request(PopupId.Spells);
                } else {
                    PopupManagerState.close-request(PopupId.Inventory);
                    PopupManagerState.close-request(PopupId.WorldList);
                    PopupManagerState.open-request(PopupId.Skills);
                }
            }
        }

        SidebarButton {
            active: PopupManagerState.world-list-open;
            icon: @image-url("../icons/sword.svg");
            clicked => {
                if (PopupManagerState.world-list-open) {
                    PopupManagerState.close-request(PopupId.WorldList);
                } else {
                    PopupManagerState.close-request(PopupId.Inventory);
                    PopupManagerState.close-request(PopupId.Skills);
                    PopupManagerState.close-request(PopupId.Spells);
                    GameState.world-list-loading = true;
                    PopupManagerState.open-request(PopupId.WorldList);
                    GameState.refresh-world-list();
                }
            }
        }

        SidebarButton {
            active: PopupManagerState.group-open;
            icon: @image-url("../icons/group.svg");
            clicked => {
                if (PopupManagerState.group-open) {
                    PopupManagerState.close-request(PopupId.Group);
                } else {
                    PopupManagerState.close-request(PopupId.Inventory);
                    PopupManagerState.close-request(PopupId.Skills);
                    PopupManagerState.close-request(PopupId.Spells);
                    PopupManagerState.close-request(PopupId.WorldList);
                    PopupManagerState.open-request(PopupId.Group);
                    GameState.request-self-profile();
                }
            }
        }
    }
}