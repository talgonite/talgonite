export struct KeyBinding {
    id: string,
    label: string,
    primary: string,
    secondary: string,
}

export global SettingsState {
    // NOTE: Open/close of the settings and game menu windows is owned by the
    // popup stack (`PopupManagerState`); there are no `show-*` booleans here.
    in-out property <int> xray-size: 0;  // 0=Off, 1=Small, 2=Medium, 3=Large
    in-out property <float> sfx-volume: 1.0;  // 0.0 to 1.0
    in-out property <float> music-volume: 1.0;  // 0.0 to 1.0
    in-out property <float> scale: 1.0;  // 1.0 to 5.0
    in-out property <float> scale-progress: (1.0 - 0.5) / 4.5;
    in-out property <string> scale-text: "1x";
    in-out property <bool> modifier-hotbar-rows-target-custom-only: true;

    // Key bindings, grouped by settings section; synced from Rust.
    in-out property <[KeyBinding]> bindings-movement: [];
    in-out property <[KeyBinding]> bindings-world: [];
    in-out property <[KeyBinding]> bindings-combat: [];
    in-out property <[KeyBinding]> bindings-interface: [];
    in-out property <[KeyBinding]> bindings-hotbar: [];
    in-out property <[KeyBinding]> bindings-panels: [];

    // Rebinding state
    in-out property <string> rebinding-action: "";
    in-out property <int> rebinding-index: 0;
    in-out property <bool> is-rebinding: false;
    callback xray-size-changed(int);
    callback sfx-volume-changed(float);
    callback music-volume-changed(float);
    callback scale-input-changed(float);
    callback modifier-hotbar-rows-target-custom-only-changed(bool);
    callback start-rebind(string, int);
    callback rebind-key(string);
    callback unbind-key(string, int);
    callback cancel-rebind();
    callback logout-requested();
    callback exit-requested();
}