// Social status enum
import { PopupManagerState, PopupId } from "popup_manager.slint";

export enum SocialStatus {
    Online,
    DoNotDisturb,
    DayDreaming,
    NeedGroup,
    Grouped,
    LoneHunter,
    GroupHunting,
    NeedHelp,
}

export struct SocialStatusEntry {
    status: SocialStatus,
    name: string,
    description: string,
    icon: string,
    color: color,
}

export struct GroupMember {
    name: string,
    is-leader: bool,
}

export struct GroupInviteNotification {
    source-name: string,
    group-name: string,
    group-note: string,
}

export struct WorldMapNode {
    text: string,
    map_id: int,
    x: int,
    y: int,
    dest_x: int,
    dest_y: int,
    check_sum: int,
}

export struct MenuEntry {
    text: string,
    styled_text: styled-text,
    id: int,
    icon: image,
    cost: int,
}

export struct ContextMenuEntry {
    id: int,
    text: string,
}

export struct InventoryItem {
    slot: int,
    name: string,
    icon: image,
    quantity: int,
}

export struct Cooldown { time_left: duration, total: duration}

export struct HotbarEntry {
    name: string,
    icon: image,
    quantity: int,
    enabled: bool,
    cooldown: Cooldown,
    cast-progress: float,
}

export struct Skill {
    name: string,
    icon: image,
    slot: int,
    cooldown: Cooldown,
}

export struct Spell {
    name: string,
    icon: image,
    slot: int,
    prompt: string,
    cast-progress: float,
}

export struct ExchangeItem {
    slot: int,
    name: string,
    icon: image,
    color: int,
    has_item: bool,
}

export struct ExchangeData {
    is_active: bool,
    other_player_name: string,
    my_gold: int,
    other_gold: int,
    my_items: [ExchangeItem],
    other_items: [ExchangeItem],
    my_accepted: bool,
    other_accepted: bool,
    pending_quantity_slot: int,
}

export enum SlotPanelType {
    none,
    item,
    skill,
    spell,
    hotbar,
    world,
    exchange,
}

// Drag/drop bridge: sources build an opaque payload, drop targets hand it to the host.
export global DragDropState {
    // Mirrors the in-flight drag's source so Slint can reject same-slot drops.
    in-out property <SlotPanelType> source-panel: SlotPanelType.none;
    in-out property <int> source-index: -1;
    pure callback make-transfer(SlotPanelType, int) -> data-transfer;
    callback dropped(data-transfer, SlotPanelType, int, length, length);
    callback drag-state-changed(bool, SlotPanelType, int);
}

export struct WorldLabel {
    entity_id: int,
    text: string,
    world_x: float,
    world_y: float,
    y_offset: float,
    color: brush,
    health_percent: int,
}

export struct CastingIndicator {
    visible: bool,
    text: string,
    progress: float,
    targeting: bool,
}

export struct SpeechBubble {
    entity_id: int,
    text: styled-text,
    world_x: float,
    world_y: float,
    y_offset: float,
}

export struct WorldListMemberUi {
    name: string,
    title: string,
    class: string,
    color: color,
    is_master: bool,
    social_status: SocialStatus,
}

export struct NpcDialogData {
    text_entry_visible: bool,
    is_shop: bool,
    interaction_enabled: bool,
    npc_name: string,
    npc_portrait: image,
    dialog_text: styled-text,
    menu_entries: [MenuEntry],
    text_entry_prompt: string,
    text_entry_args: string,
}

export struct ChatMessage {
    text: styled-text,
    color: brush,
}

// Equipment slot for profile display
export struct EquipmentSlotData {
    name: string,
    icon: image,
    has-item: bool,
    durability-percent: float,
    current-durability: int,
    max-durability: int,
}

export struct LegendMarkData {
    icon-name: string,
    color: color,
    text: string,
}

// Profile data for player/character profile display
export struct ProfileData {
    is-self: bool,
    name: string,
    class: string,
    guild: string,
    guild-rank: string,
    title: string,
    town: string,
    town-banner: image,
    portrait: image,
    preview: image,
    profile-text: string,
    social-status: SocialStatus,
    group-requests-enabled: bool,
    legend-marks: [LegendMarkData],
    // Equipment slots (22 slots total)
    // Row 1: Greaves, Boots, Belt
    eq-greaves: EquipmentSlotData,
    eq-boots: EquipmentSlotData,
    eq-belt: EquipmentSlotData,
    // Row 2: Left Gauntlet, Left Ring, Right Ring, Right Gauntlet
    eq-left-gauntlet: EquipmentSlotData,
    eq-left-ring: EquipmentSlotData,
    eq-right-ring: EquipmentSlotData,
    eq-right-gauntlet: EquipmentSlotData,
    // Row 3: Weapon, Shield, Accessory 2
    eq-weapon: EquipmentSlotData,
    eq-shield: EquipmentSlotData,
    eq-accessory2: EquipmentSlotData,
    // Row 4: Over Armor, Armor, Over Helmet, Overcoat, Accessory 1
    eq-over-armor: EquipmentSlotData,
    eq-armor: EquipmentSlotData,
    eq-over-helmet: EquipmentSlotData,
    eq-overcoat: EquipmentSlotData,
    eq-accessory1: EquipmentSlotData,
    // Row 5: Earrings, Helmet, Necklace
    eq-earrings: EquipmentSlotData,
    eq-helmet: EquipmentSlotData,
    eq-necklace: EquipmentSlotData,
}

export global GameState {
    in-out property <string> map_name: "Mileth Village";
    in-out property <float> player_x: 5;
    in-out property <float> player_y: 10;
    in-out property <int> current_hp: 850;
    in-out property <int> max_hp: 1200;
    in-out property <int> current_mp: 320;
    in-out property <int> max_mp: 500;
    in-out property <float> hp-fraction: 850.0 / 1200.0;
    in-out property <float> mp-fraction: 320.0 / 500.0;
    in-out property <int> player_id: 12345;
    in-out property <string> server_name: "Darkages";
    in-out property <int> ping_ms: 45;
    in-out property <string> player_name: "Warrior";
    in-out property <image> player_portrait: @image-url("");

    // Camera state for world-to-screen coordinate conversion
    // camera_x/y are in isometric world coordinates
    in-out property <float> camera_x: 0;
    in-out property <float> camera_y: 0;
    // camera_zoom is the zoom applied during GPU rendering (may be < 1.0)
    in-out property <float> camera_zoom: 1;
    // viewport_width/height are the render texture dimensions
    in-out property <float> viewport_width: 800;
    in-out property <float> viewport_height: 600;
    // display_scale is how much the render texture is scaled up for display
    // (display_size / render_size, typically user_zoom for pixel-perfect rendering)
    in-out property <float> display_scale: 1;
    in-out property <string> responsive-mode: "normal";
    in-out property <bool> responsive-compact: false;
    in-out property <bool> responsive-wide: false;
    in-out property <CastingIndicator> casting-indicator: {
        visible: false,
        text: "Casting...",
        progress: 0.0,
        targeting: false,
    };
    in-out property <[WorldLabel]> world_labels: [];
    in-out property <[SpeechBubble]> speech_bubbles: [];
    in-out property <[ChatMessage]> chat-messages: [];
    in-out property <[string]> action-bar-messages: [];
    in-out property <int> action-bar-update-counter: 0;
    in-out property <string> last_whisper_target: "";
    in-out property <[WorldMapNode]> world-map-nodes: [];
    in-out property <image> world-map-image: @image-url("");
    in-out property <string> world-map-name: "";
    in-out property <[InventoryItem]> inventory: [];
    in-out property <[Skill]> skills: [];
    in-out property <[Spell]> spells: [];
    in-out property <[HotbarEntry]> hotbar: [];
    in-out property <bool> world-list-loading: false;
    in-out property <[WorldListMemberUi]> world-list-members: [];
    in-out property <int> world-list-count: 0;
    in-out property <int> world-list-total-count: 0;
    in-out property <ProfileData> profile: {
        is-self: false,
        name: "Unknown",
        class: "Peasant",
        guild: "",
        guild-rank: "",
        title: "",
        town: "Mileth",
        profile-text: "",
        social-status: SocialStatus.Online,
        group-requests-enabled: true,
    };
    in-out property <int> current-hotbar-panel: 0;
    in-out property <int> hotbar-row-count: 1;
    in-out property <bool> is-groupable: false;
    in-out property <bool> is-group-leader: false;
    in-out property <[GroupMember]> group-members: [];
    in-out property <GroupInviteNotification> group-invite: { source-name: "", group-name: "", group-note: "" };
    in-out property <ExchangeData> exchange: {
        is_active: false,
        other_player_name: "",
        my_gold: 0,
        other_gold: 0,
        my_items: [],
        other_items: [],
        my_accepted: false,
        other_accepted: false,
        pending_quantity_slot: 0,
    };
    callback world-map-click(int, int, int, int);
    callback set-hotbar-panel(int);
    callback expand-hotbar();
    callback collapse-hotbar();
    callback send-chat(string);
    callback send-whisper(string, string);
    callback unequip(int);
    callback refresh-world-list();
    callback set-world-list-filter(string, bool, string); // class, master_only, search

    callback use-action(SlotPanelType, int);
    // Group: invite/kick (Request 02), accept (Forced 03 + inviter name), leave (ToggleGroup 0x2F), refresh
    callback toggle-groupable();
    callback send-group-invite(string);
    callback respond-group-invite(bool, string);
    callback kick-group-member(string);
    callback leave-group();
    callback request-self-profile();
    callback cancel-spell-targeting();

    // Exchange callbacks
    callback exchange-add-item(int);
    callback exchange-add-stackable-item(int, int);
    callback exchange-set-gold(int);
    callback exchange-cancel-quantity();
    callback exchange-accept();
    callback exchange-cancel();
}

export global PopupState {
    in-out property <string> text: "";
    in-out property <bool> visible: false;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <length> anchor-width: 0px;
    in-out property <length> anchor-height: 0px;
    public function show(text: string, x: length, y: length, w: length, h: length) {
        root.text = text;
        root.x = x;
        root.y = y;
        root.anchor-width = w;
        root.anchor-height = h;
        root.visible = true;
    }
    public function hide() {
        root.visible = false;
    }
}

export global ContextMenuState {
    in-out property <string> title: "";
    in-out property <[ContextMenuEntry]> items: [];
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <length> anchor-width: 0px;
    in-out property <length> anchor-height: 0px;
    callback item-selected-request(int);
    callback close-request();

    // Only sets data; open/close ownership lives in the Rust `PopupManager`
    // (Rust calls `open` on show and `close` on hide).
    public function show(title: string, items: [ContextMenuEntry], x: length, y: length, w: length, h: length) {
        root.title = title;
        root.items = items;
        root.x = x;
        root.y = y;
        root.anchor-width = w;
        root.anchor-height = h;
    }

    public function select-item(id: int) {
        PopupManagerState.close-request(PopupId.ContextMenu);
        item-selected-request(id);
    }

    public function close() {
        PopupManagerState.close-request(PopupId.ContextMenu);
    }

    public function hide() {
        root.title = "";
        root.items = [];
    }
}

// NPC Dialog State - handles conversations and text entry
export global NpcDialogState {
    in-out property <NpcDialogData> data: {
        interaction_enabled: true,
    };

    // Internal request callbacks (Rust listens to these)
    callback select-option-request(int, string);
    callback close-request();
    callback submit-text-request(string);

    // Public API for UI (handles locking and immediate state changes)
    public function select-option(id: int, text: string) {
        if data.interaction_enabled {
            data.interaction_enabled = false;
            select-option-request(id, text);
        }
    }
    public function close() {
        if data.interaction_enabled {
            data.interaction_enabled = false;
            data.text_entry_visible = false;
            PopupManagerState.close-request(PopupId.NpcDialog);
        }
    }
    public function submit-text(text: string) {
        if data.interaction_enabled {
            data.interaction_enabled = false;
            data.text_entry_visible = false;
            submit-text-request(text);
        }
    }
    public function reset() {
        data = {
            interaction_enabled: true,
        };
    }
}

// Social status state for Rust <-> Slint bridge
// UI-specific concerns (dropdown state, status options) live in the components
export global SocialStatusState {
    in-out property <SocialStatus> current-status: SocialStatus.Online;
    in-out property <bool> enabled: true;

    // Callback for Rust bridge - called when user changes status
    callback status-changed(SocialStatus);
}
